{
  "info": {
    "name": "ProcureAI - Auth (Sign-up & Login)",
    "description": "Sign-up, login and protected endpoints for the AI Procurement SaaS backend.\n\nRun in order: 1 -> 2 -> 3. The Login request saves the JWT into the collection variable `accessToken`; every protected request uses it automatically (collection-level Bearer auth).\n\nChange `baseUrl` if your backend runs on a different port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "email", "value": "buyer1@example.com" },
    { "key": "password", "value": "Secret123" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register - Buyer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Role is BUYER_OWNER, never admin', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.platformRole).to.eql('USER');",
              "  pm.expect(body.memberships[0].role).to.eql('BUYER_OWNER');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Aisha Rahman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"accountType\": \"BUYER\",\n  \"companyName\": \"Doha Foods LLC\",\n  \"countryCode\": \"QA\",\n  \"registrationNo\": \"\"\n}"
        }
      }
    },
    {
      "name": "1b. Register - Supplier",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Omar Khan\",\n  \"email\": \"supplier1@example.com\",\n  \"password\": \"Secret123\",\n  \"accountType\": \"SUPPLIER\",\n  \"companyName\": \"PackSupply Trading\",\n  \"countryCode\": \"AE\"\n}"
        }
      }
    },
    {
      "name": "2. Login (saves token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (body.accessToken) {",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "  console.log('Saved accessToken, expires in ' + body.expiresIn + 's');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "3. Get my profile (protected)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/users/me"
      }
    },
    {
      "name": "4. Buyer dashboard (BUYER role)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/buyer/dashboard"
      }
    },
    {
      "name": "5. Supplier dashboard (SUPPLIER role - 403 for buyers)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/supplier/dashboard"
      }
    },
    {
      "name": "Health check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Negative tests",
      "item": [
        {
          "name": "Register with accountType ADMIN -> 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mallory\",\n  \"email\": \"mallory@example.com\",\n  \"password\": \"Secret123\",\n  \"accountType\": \"ADMIN\",\n  \"companyName\": \"Evil Co\",\n  \"countryCode\": \"QA\"\n}"
            }
          }
        },
        {
          "name": "Register with weak password -> 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Weak\",\n  \"email\": \"weak@example.com\",\n  \"password\": \"short\",\n  \"accountType\": \"BUYER\",\n  \"companyName\": \"Weak Co\",\n  \"countryCode\": \"QA\"\n}"
            }
          }
        },
        {
          "name": "Login with wrong password -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPass1\"\n}"
            }
          }
        },
        {
          "name": "Profile without token -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        }
      ]
    }
  ]
}
